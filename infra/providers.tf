terraform {
  required_version = ">= 1.6"

  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 6.0"
    }
    google-beta = {
      source  = "hashicorp/google-beta"
      version = "~> 6.0"
    }
  }

  # State managed by Google Cloud Infrastructure Manager.
  # For local development before IM is bootstrapped:
  #   tofu init -backend-config="bucket=PROJECT-tofu-state" -backend-config="prefix=infra/dev"
  backend "gcs" {}
}

provider "google" {
  project = var.project_id
  region  = var.region
}

provider "google-beta" {
  project = var.project_id
  region  = var.region
}
