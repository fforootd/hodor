{
  "type": "login_flow",
  "version": "1.0.0",
  "name": "SSO Enterprise",
  "description": "Enterprise SSO-only login experience. Users authenticate exclusively via their corporate identity provider. No local passwords, no self-registration.",
  "variables": {
    "primary_color": {
      "type": "string",
      "description": "Brand color for the login screen",
      "default": "#1e293b"
    },
    "company_name": {
      "type": "string",
      "description": "Company name shown on the login screen",
      "default": "Your Organization"
    }
  },
  "payload": {
    "display_name": "SSO Enterprise Login",
    "preset": "sso_only",
    "auth_methods": {
      "passkey":    { "enabled": false, "interactive": true, "position": 0 },
      "password":   { "enabled": false, "interactive": true, "position": 1 },
      "magic_link": { "enabled": false, "interactive": true, "position": 2 },
      "sso":        { "enabled": true,  "interactive": true, "position": 0 }
    },
    "config": {
      "branding": {
        "heading": "Sign in to {{company_name}}",
        "colors": { "primary": "{{primary_color}}" },
        "layout": "centered",
        "hide_registration": true
      }
    },
    "actions": []
  }
}
