  "type": "object",
  "properties": {
    "x-auth-methods": {
      "type": "object",
      "description": "Auth methods available for identities of this schema type.",
      "additionalProperties": {
        "$ref": "#/$defs/AuthMethodEntry"
      },
      "propertyNames": {
        "enum": ["password", "passkey", "magic_link", "sso", "pat", "api_key", "client_cert", "client_secret"]
      }
    },
    "x-login": {
      "type": "object",
      "description": "Interactive login flow configuration (default, overridable via settings).",
      "properties": {
        "preset":                { "type": "string", "enum": ["identifier_first", "passkey_first", "sso_only", "custom"], "default": "identifier_first" },
        "mfa_required":          { "type": "boolean", "default": false },
        "registration_allowed":  { "type": "boolean", "default": true }
      },
      "additionalProperties": false
    },
    "x-branding": {
      "type": "object",
      "description": "Visual customization for the login UI (default, overridable via settings).",
      "properties": {
        "heading":              { "type": "string" },
        "description":          { "type": "string" },
        "logo_url":             { "type": "string", "format": "uri" },
        "org_name":             { "type": "string" },
        "colors": {
          "type": "object",
          "properties": {
            "primary":            { "type": "string" },
            "primary_foreground": { "type": "string" },
            "background":         { "type": "string" },
            "surface":            { "type": "string" },
            "text":               { "type": "string" },
            "muted":              { "type": "string" },
            "accent":             { "type": "string" },
            "border":             { "type": "string" },
            "error":              { "type": "string" }
          },
          "additionalProperties": { "type": "string" }
        },
        "font_family":           { "type": "string" },
        "font_url":              { "type": "string", "format": "uri" },
        "texts":                 { "type": "object", "additionalProperties": { "type": "string" } },
        "custom_css":            { "type": "string" },
        "hide_zitadel_branding": { "type": "boolean" },
        "layout":                { "type": "string", "enum": ["centered", "split", "muted", "card_image", "minimal"], "default": "centered" },
        "dark_mode":             { "type": "string", "enum": ["light", "dark", "auto"], "default": "light" },
        "cover_image":           { "type": "string", "format": "uri", "description": "URL for cover/hero image (used by split and card_image layouts)" },
        "logo_dark":             { "type": "string", "format": "uri", "description": "Alternative logo for dark mode" },
        "favicon":               { "type": "string", "format": "uri" },
        "border_radius":         { "type": "string", "enum": ["sm", "md", "lg", "xl", "full"], "default": "md" },
        "terms_url":             { "type": "string", "format": "uri" },
        "privacy_url":           { "type": "string", "format": "uri" },
        "social_position":       { "type": "string", "enum": ["top", "bottom"], "default": "bottom" },
        "consent": {
          "type": "array",
          "description": "Consent checkboxes shown during registration/login (e.g. terms acceptance, marketing opt-in).",
          "items": {
            "type": "object",
            "properties": {
              "id":       { "type": "string", "description": "Unique key for the consent item" },
              "label":    { "type": "string", "description": "Display label, supports markdown links: I agree to the [Terms](https://...)" },
              "required": { "type": "boolean", "default": false }
            },
            "required": ["id", "label"]
          }
        }
      },
      "additionalProperties": false
    },
    "properties": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "x-identifier":  { "type": "boolean", "description": "Field can be used as a login identifier" },
          "x-verify":      { "type": "string", "enum": ["email", "sms"], "description": "Verification channel" },
          "x-recover":     { "type": "string", "enum": ["email", "sms"], "description": "Recovery channel" },
          "x-mfa":         { "type": "string", "enum": ["sms", "totp"], "description": "MFA method via this field" },
          "x-claim":       { "type": "string", "description": "Expr mapping to OIDC claims" },
          "x-sensitive":   { "type": "boolean" },
          "x-hidden":      { "type": "boolean" },
          "x-editable":    { "type": "boolean" },
          "x-source":      { "type": "string", "enum": ["admin", "user", "system", "sso"] },
          "x-unique":      { "oneOf": [{ "type": "string", "enum": ["instance", "org"] }, { "type": "boolean", "const": false }], "description": "Uniqueness scope: 'instance' = globally unique, 'org' = unique per org. Orthogonal to x-identifier." }
        }
      }
    }
  },
  "$defs": {
    "AuthMethodEntry": {
      "type": "object",
      "description": "Configuration for a single auth method.",
      "properties": {
        "enabled":     { "type": "boolean" },
        "interactive": { "type": "boolean", "description": "true = browser-based login, false = API/token-based" },
        "position":    { "type": "integer", "minimum": 0, "description": "Display order for interactive methods" },
        "preferred":   { "type": "boolean" },
        "max_tokens":  { "type": "integer", "minimum": 1, "description": "Max tokens for PAT/API key methods" }
      },
      "required": ["enabled", "interactive"]
    }
  }
}
