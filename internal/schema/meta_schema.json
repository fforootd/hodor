{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zitadel.com/schemas/v1/entity-meta-schema",
  "title": "ZITADEL Entity Meta-Schema",
  "description": "Catalog of entity types, nav groups, and annotation validation.",

  "x-groups": {
    "identities":    { "label": "Identities",    "icon": "👥", "sort_order": 1 },
    "applications":  { "label": "Applications",  "icon": "📱", "sort_order": 2 },
    "configure":     { "label": "Configure",     "icon": "⚙️", "sort_order": 3 },
    "observability": { "label": "Observability", "icon": "📊", "sort_order": 4 },
    "settings":      { "label": "Settings",      "icon": "🔧", "sort_order": 5, "nav": "hidden" },
    "system":        { "label": "System",        "icon": "🔧", "sort_order": 6, "nav": "hidden" }
  },

  "x-catalog": {
    "human_user": {
      "$ref": "schemas/human_user.json",
      "version": "1.0",
      "group": "identities",
      "alias": "Users",
      "singular": "User",
      "path": "users",
      "icon": "👤",
      "sort_order": 1,
      "required": true,
      "storage": "entities",
      "engines": {
        "authorization": { "model": "fga", "relations": ["member", "owner", "viewer"] },
        "claims":        { "model": "expr", "direction": "outbound" },
        "login":         { "model": "built-in" }
      }
    },
    "service_user": {
      "$ref": "schemas/service_user.json",
      "version": "1.0",
      "group": "identities",
      "alias": "Service Accounts",
      "singular": "Service Account",
      "path": "service-accounts",
      "icon": "🤖",
      "sort_order": 2,
      "storage": "entities",
      "engines": {
        "authorization": { "model": "fga", "relations": ["member", "owner"] }
      }
    },
    "ai_agent": {
      "$ref": "schemas/ai_agent.json",
      "version": "1.0",
      "group": "identities",
      "alias": "AI Agents",
      "singular": "AI Agent",
      "path": "ai-agents",
      "icon": "🧠",
      "sort_order": 3,
      "storage": "entities",
      "engines": {
        "authorization": { "model": "fga", "relations": ["owner", "viewer"] }
      }
    },
    "app": {
      "$ref": "schemas/app.json",
      "version": "1.0",
      "group": "applications",
      "alias": "OIDC Clients",
      "singular": "OIDC Client",
      "path": "apps",
      "icon": "📱",
      "sort_order": 1,
      "storage": "entities",
      "engines": {
        "authorization": { "model": "fga", "relations": ["owner", "viewer"] },
        "claims":        { "model": "expr", "direction": "outbound" }
      }
    },
    "rule": {
      "$ref": "schemas/rule.json",
      "version": "1.0",
      "group": "configure",
      "alias": "Rules",
      "singular": "Rule",
      "path": "rules",
      "icon": "⚡",
      "sort_order": 2,
      "storage": "entities"
    },
    "provider": {
      "$ref": "schemas/provider.json",
      "version": "1.0",
      "group": "configure",
      "alias": "Providers",
      "singular": "Provider",
      "path": "providers",
      "icon": "🔗",
      "sort_order": 1,
      "storage": "dedicated",
      "route": "/providers"
    },
    "session": {
      "$ref": "schemas/session.json",
      "version": "1.0",
      "group": "observability",
      "alias": "Sessions",
      "singular": "Session",
      "path": "sessions",
      "icon": "🔑",
      "sort_order": 1,
      "storage": "dedicated",
      "route": "/sessions"
    },
    "event": {
      "$ref": "schemas/event.json",
      "version": "1.0",
      "group": "observability",
      "alias": "Events",
      "singular": "Event",
      "path": "events",
      "icon": "📋",
      "sort_order": 2,
      "storage": "dedicated",
      "route": "/events"
    },
    "job": {
      "$ref": "schemas/job.json",
      "version": "1.0",
      "group": "observability",
      "alias": "Jobs",
      "singular": "Job",
      "path": "jobs",
      "icon": "⚡",
      "sort_order": 3,
      "storage": "dedicated",
      "route": "/jobs"
    },
    "password_policy": {
      "$ref": "schemas/password_policy.json",
      "version": "1.0",
      "group": "settings",
      "alias": "Password Policy",
      "singular": "Password Policy",
      "path": "settings/password-policy",
      "icon": "🔒",
      "sort_order": 1,
      "storage": "settings",
      "nav": "hidden"
    },
    "identifier_policy": {
      "$ref": "schemas/identifier_policy.json",
      "version": "1.0",
      "group": "settings",
      "alias": "Identifier Policy",
      "singular": "Identifier Policy",
      "path": "settings/identifier-policy",
      "icon": "🆔",
      "sort_order": 2,
      "storage": "settings",
      "nav": "hidden"
    },
    "login_policy": {
      "$ref": "schemas/login_policy.json",
      "version": "1.0",
      "group": "settings",
      "alias": "Login Policy",
      "singular": "Login Policy",
      "path": "settings/login-policy",
      "icon": "🚪",
      "sort_order": 3,
      "storage": "settings",
      "nav": "hidden"
    },
    "lockout_policy": {
      "$ref": "schemas/lockout_policy.json",
      "version": "1.0",
      "group": "settings",
      "alias": "Lockout Policy",
      "singular": "Lockout Policy",
      "path": "settings/lockout-policy",
      "icon": "🔐",
      "sort_order": 4,
      "storage": "settings",
      "nav": "hidden"
    },
    "rate_limit": {
      "$ref": "schemas/rate_limit.json",
      "version": "1.0",
      "group": "settings",
      "alias": "Rate Limit",
      "singular": "Rate Limit",
      "path": "settings/rate-limit",
      "icon": "⏱️",
      "sort_order": 5,
      "storage": "settings",
      "nav": "hidden"
    },
    "session_policy": {
      "$ref": "schemas/session_policy.json",
      "version": "1.0",
      "group": "settings",
      "alias": "Session Policy",
      "singular": "Session Policy",
      "path": "settings/session-policy",
      "icon": "⏳",
      "sort_order": 6,
      "storage": "settings",
      "nav": "hidden"
    },
    "notification": {
      "$ref": "schemas/notification.json",
      "version": "1.0",
      "group": "settings",
      "alias": "Notification",
      "singular": "Notification Settings",
      "path": "settings/notification",
      "icon": "🔔",
      "sort_order": 7,
      "storage": "settings",
      "nav": "hidden"
    },
    "schema": {
      "group": "system",
      "alias": "Schemas",
      "singular": "Schema",
      "path": "schemas",
      "icon": "📐",
      "sort_order": 1,
      "storage": "dedicated",
      "route": "/schemas",
      "nav": "visible"
    },
    "org": {
      "$ref": "schemas/org.json",
      "version": "1.0",
      "group": "system",
      "alias": "Organizations",
      "singular": "Organization",
      "path": "orgs",
      "icon": "🏢",
      "sort_order": 2,
      "storage": "entities",
      "nav": "hidden",
      "engines": {
        "authorization": { "model": "fga", "relations": ["member", "owner", "admin"] }
      }
    }
  },

  "type": "object",
  "properties": {
    "x-auth-methods": {
      "type": "object",
      "description": "Auth methods available for identities of this schema type.",
      "additionalProperties": {
        "$ref": "#/$defs/AuthMethodEntry"
      },
      "propertyNames": {
        "enum": ["password", "passkey", "magic_link", "sso", "pat", "api_key", "client_cert", "client_secret"]
      }
    },
    "x-login": {
      "type": "object",
      "description": "Interactive login flow configuration (default, overridable via settings).",
      "properties": {
        "preset":                { "type": "string", "enum": ["identifier_first", "passkey_first", "sso_only", "custom"], "default": "identifier_first" },
        "mfa_required":          { "type": "boolean", "default": false },
        "registration_allowed":  { "type": "boolean", "default": true }
      },
      "additionalProperties": false
    },
    "x-branding": {
      "type": "object",
      "description": "Visual customization for the login UI (default, overridable via settings).",
      "properties": {
        "heading":              { "type": "string" },
        "description":          { "type": "string" },
        "logo_url":             { "type": "string", "format": "uri" },
        "org_name":             { "type": "string" },
        "colors": {
          "type": "object",
          "properties": {
            "primary":    { "type": "string" },
            "background": { "type": "string" },
            "surface":    { "type": "string" },
            "text":       { "type": "string" },
            "error":      { "type": "string" }
          },
          "additionalProperties": { "type": "string" }
        },
        "font_family":           { "type": "string" },
        "font_url":              { "type": "string", "format": "uri" },
        "texts":                 { "type": "object", "additionalProperties": { "type": "string" } },
        "custom_css":            { "type": "string" },
        "hide_zitadel_branding": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "properties": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "x-identifier":  { "type": "boolean", "description": "Field can be used as a login identifier" },
          "x-verify":      { "type": "string", "enum": ["email", "sms"], "description": "Verification channel" },
          "x-recover":     { "type": "string", "enum": ["email", "sms"], "description": "Recovery channel" },
          "x-mfa":         { "type": "string", "enum": ["sms", "totp"], "description": "MFA method via this field" },
          "x-claim":       { "type": "string", "description": "Expr mapping to OIDC claims" },
          "x-sensitive":   { "type": "boolean" },
          "x-hidden":      { "type": "boolean" },
          "x-editable":    { "type": "boolean" },
          "x-source":      { "type": "string", "enum": ["admin", "user", "system", "sso"] }
        }
      }
    }
  },
  "$defs": {
    "AuthMethodEntry": {
      "type": "object",
      "description": "Configuration for a single auth method.",
      "properties": {
        "enabled":     { "type": "boolean" },
        "interactive": { "type": "boolean", "description": "true = browser-based login, false = API/token-based" },
        "position":    { "type": "integer", "minimum": 0, "description": "Display order for interactive methods" },
        "preferred":   { "type": "boolean" },
        "max_tokens":  { "type": "integer", "minimum": 1, "description": "Max tokens for PAT/API key methods" }
      },
      "required": ["enabled", "interactive"]
    }
  }
}
