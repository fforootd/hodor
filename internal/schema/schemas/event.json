{
  "$schema": "https://zitadel.com/schemas/v1/entity",
  "$version": "1.0",
  "type": "object",
  "description": "Audit event recorded in the event stream. Read-only.",
  "properties": {
    "id": {
      "type": "string",
      "readOnly": true
    },
    "event_type": {
      "type": "string",
      "description": "Event type (e.g., entity.created, auth.login)"
    },
    "aggregate_type": {
      "type": "string",
      "description": "Aggregate this event belongs to (e.g., user, org, app)"
    },
    "aggregate_id": {
      "type": "string",
      "description": "ID of the affected aggregate",
      "x-ref": {
        "resource": "entities",
        "display": "identifier",
        "path": "/console/s/{type}/{id}"
      }
    },
    "org_id": {
      "type": "string"
    },
    "actor_id": {
      "type": "string",
      "description": "Entity that caused the event",
      "x-ref": {
        "resource": "entities",
        "display": "display_name",
        "path": "/console/s/{type}/{id}",
        "inverse": "events?actor_id={id}"
      }
    },
    "actor_type": {
      "type": "string",
      "enum": [
        "human",
        "service",
        "system",
        "agent"
      ],
      "description": "Kind of entity that triggered the event"
    },
    "payload": {
      "type": "object",
      "description": "Event-specific data"
    },
    "metadata": {
      "type": "object",
      "description": "Contextual metadata (IP, user-agent, geo)"
    },
    "trace_id": {
      "type": "string",
      "description": "Distributed trace identifier for causal chain grouping"
    },
    "span_id": {
      "type": "string",
      "description": "Span identifier within the trace"
    },
    "parent_span_id": {
      "type": "string",
      "description": "Parent span for trace tree reconstruction"
    },
    "session_id": {
      "type": "string",
      "description": "Session that produced this event",
      "x-ref": {
        "resource": "sessions",
        "display": "id",
        "path": "/console/sessions"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    }
  },
  "required": [
    "event_type",
    "aggregate_type",
    "aggregate_id"
  ]
}
