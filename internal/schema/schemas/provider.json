{
  "$schema": "https://zitadel.com/schemas/v1/entity",
  "$version": "1.0",
  "type": "object",
  "description": "External identity provider (OIDC, SAML, social login).",
  "x-table": "providers",
  "properties": {
    "display_name": {
      "type": "string",
      "description": "Provider display name (shown on login)"
    },
    "protocol": {
      "type": "string",
      "enum": [
        "oidc",
        "saml",
        "oauth2",
        "ldap"
      ],
      "description": "Protocol type"
    },
    "template": {
      "type": "string",
      "description": "Template ID (google, entraid, gitlab, apple, custom)"
    },
    "issuer": {
      "type": "string",
      "format": "uri",
      "description": "Issuer URL (OIDC discovery)"
    },
    "client_id": {
      "type": "string"
    },
    "client_secret": {
      "type": "string",
      "x-sensitive": true
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "openid",
        "profile",
        "email"
      ]
    },
    "config": {
      "type": "object",
      "description": "Protocol-specific configuration (issuer, client_id, scopes, etc.)"
    },
    "claim_mapping": {
      "type": "object",
      "description": "Map external claims to Zitadel fields"
    },
    "claim_overrides": {
      "type": "object",
      "description": "Expression-based claim override mappings"
    },
    "auto_register": {
      "type": "boolean",
      "default": false,
      "description": "Auto-create user on first login"
    },
    "auto_link": {
      "type": "string",
      "enum": [
        "email",
        "username",
        "none"
      ],
      "default": "email",
      "description": "Auto-link to existing user by field"
    },
    "logo_url": {
      "type": "string",
      "format": "uri"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "display_order": {
      "type": "integer",
      "default": 0,
      "description": "Sort order for login page display"
    }
  },
  "required": [
    "display_name",
    "protocol"
  ]
}
