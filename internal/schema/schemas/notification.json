{
  "$version": "1.0",
  "type": "object",
  "x-display": {
    "alias": "Notification",
    "singular": "Notification Settings",
    "group": "settings",
    "path": "settings/notification",
    "icon": "🔔"
  },
  "x-settings": {
    "hierarchy": [
      "instance",
      "org"
    ],
    "merge_strategy": "deep_merge",
    "inherit": true
  },
  "properties": {
    "email_from": {
      "type": "string",
      "format": "email",
      "description": "Sender email address"
    },
    "email_from_name": {
      "type": "string",
      "description": "Sender display name"
    },
    "smtp_host": {
      "type": "string",
      "description": "SMTP server hostname"
    },
    "smtp_port": {
      "type": "integer",
      "default": 587,
      "description": "SMTP port"
    },
    "smtp_user": {
      "type": "string"
    },
    "smtp_password": {
      "type": "string",
      "x-sensitive": true
    },
    "smtp_tls": {
      "type": "boolean",
      "default": true
    },
    "sms_provider": {
      "type": "string",
      "enum": [
        "twilio",
        "custom",
        "none"
      ],
      "default": "none"
    },
    "sms_config": {
      "type": "object",
      "description": "Provider-specific SMS configuration"
    },
    "webhook_url": {
      "type": "string",
      "format": "uri",
      "description": "Default webhook endpoint"
    }
  }
}
