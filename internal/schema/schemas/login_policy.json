{
  "$schema": "https://zitadel.com/schemas/v1/settings",
  "$version": "1.0",
  "type": "object",
  "x-settings": {
    "hierarchy": [
      "instance",
      "org",
      "app"
    ],
    "merge_strategy": "deep_merge",
    "inherit": true
  },
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "identifier_first",
        "passkey_first",
        "sso_only",
        "custom"
      ],
      "default": "identifier_first"
    },
    "mfa_required": {
      "type": "boolean",
      "default": false,
      "description": "Force MFA for all users"
    },
    "mfa_grace_period_days": {
      "type": "integer",
      "default": 0,
      "description": "Days before MFA is enforced (0 = immediate)"
    },
    "passwordless_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Allow passkey/WebAuthn login"
    },
    "registration_allowed": {
      "type": "boolean",
      "default": true,
      "description": "Allow self-registration"
    },
    "external_idp_only": {
      "type": "boolean",
      "default": false,
      "description": "Only allow login via external IdPs"
    },
    "allowed_idps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Restrict to specific provider IDs (empty = all)"
    },
    "force_mfa_local_only": {
      "type": "boolean",
      "default": false,
      "description": "MFA only for local auth, skip for SSO"
    }
  }
}
