{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "outDir": "./dist",
    "paths": {
      "@/*": ["./src/*", "../packages/console-kit/src/*"],
      "@zitadel/client-js": ["../packages/console-kit/src/lib/zitadel-client-stub.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "../packages/console-kit/src/**/*.ts", "../packages/console-kit/src/**/*.vue"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
