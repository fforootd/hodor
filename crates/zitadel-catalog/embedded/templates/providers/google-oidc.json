{
  "type": "provider",
  "version": "1.0.0",
  "name": "Google OIDC",
  "description": "Google identity provider with standard OpenID Connect configuration. Maps Google profile claims to Zitadel identity fields including email, name, and profile picture.",
  "variables": {
    "provider_name": {
      "type": "string",
      "description": "Display name for this provider instance (shown on the login screen)",
      "default": "Google"
    },
    "client_id": {
      "type": "string",
      "description": "Google OAuth 2.0 Client ID (from Google Cloud Console)"
    },
    "client_secret": {
      "type": "string",
      "description": "Google OAuth 2.0 Client Secret",
      "sensitive": true
    }
  },
  "payload": {
    "display_name": "{{provider_name}}",
    "kind": "google",
    "protocol": "oidc",
    "connection": {
      "issuer": "https://accounts.google.com",
      "client_id": "{{client_id}}",
      "client_secret": "{{client_secret}}",
      "scopes": ["openid", "profile", "email"]
    },
    "mapping": {
      "claims": {
        "email": "claims.email",
        "email_verified": "claims.email_verified",
        "display_name": "claims.name",
        "first_name": "claims.given_name",
        "last_name": "claims.family_name",
        "picture": "claims.picture",
        "locale": "claims.locale"
      }
    },
    "target": {
      "schema_type": "human_user"
    },
    "linking": {
      "mode": "create_or_link",
      "match_by": "verified_email"
    },
    "session": {},
    "ui": {
      "display_order": 10
    },
    "enabled": true
  }
}
