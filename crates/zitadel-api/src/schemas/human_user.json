{
  "$schema": "https://zitadel.com/schemas/v1/entity",
  "$version": "1.0",
  "type": "object",
  "x-table": "users",
  "x-table-filter": { "user_type": "human" },

  "x-auth-methods": {
    "password":   { "enabled": true,  "interactive": true,  "position": 1 },
    "passkey":    { "enabled": false, "interactive": true,  "position": 0 },
    "magic_link": { "enabled": true,  "interactive": true,  "position": 2 },
    "sso":        { "enabled": true,  "interactive": true,  "position": 3 },
    "pat":        { "enabled": false, "interactive": false }
  },


  "properties": {
    "display_name": {
      "type": "string",
      "description": "Full name shown in UI",
      "x-editable": true,
      "x-claim": "claims.name ?? (claims.given_name + ' ' + claims.family_name)"
    },
    "email": {
      "type": "string",
      "format": "email",
      "x-editable": true,
      "x-claim": "claims.email",
      "x-identifier": true,
      "x-unique": "instance",
      "x-verify": "email",
      "x-recover": "email"
    },
    "username": {
      "type": "string",
      "description": "Login username, unique per org",
      "x-editable": true,
      "x-identifier": true,
      "x-unique": "org"
    },
    "phone": {
      "type": "string",
      "x-editable": true,
      "x-sensitive": true,
      "x-claim": "claims.phone_number ?? ''",
      "x-identifier": true,
      "x-mfa": "sms"
    },
    "locale": {
      "type": "string",
      "description": "BCP-47 language tag, e.g. en-US",
      "x-editable": true,
      "x-claim": "claims.locale ?? ''"
    },
    "timezone": {
      "type": "string",
      "description": "IANA timezone, e.g. America/New_York",
      "x-editable": true,
      "x-claim": "claims.zoneinfo ?? ''"
    },
    "avatar_url": {
      "type": "string",
      "format": "uri",
      "x-editable": true,
      "x-claim": "claims.picture ?? ''"
    },
    "metadata": {
      "type": "object",
      "description": "Arbitrary key-value pairs",
      "x-editable": false,
      "x-hidden": true,
      "x-source": "admin"
    }
  },
  "required": ["display_name"]
}
