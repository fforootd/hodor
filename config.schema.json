{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Config",
  "description": "Runtime configuration for the Zitadel server. Covers infrastructure-level settings only. Domain-specific configuration (policies, whitelabeling) lives in seed YAML.",
  "type": "object",
  "properties": {
    "cache": {
      "default": {
        "shared": {
          "backend": "disabled",
          "url": ""
        }
      },
      "allOf": [
        {
          "$ref": "#/definitions/CacheConfig"
        }
      ]
    },
    "catalog": {
      "default": {
        "local_path": "",
        "refresh_interval": "",
        "url": ""
      },
      "allOf": [
        {
          "$ref": "#/definitions/CatalogConfig"
        }
      ]
    },
    "cloud": {
      "default": {
        "control_plane": {
          "secret_ref": "",
          "url": ""
        },
        "enabled": false,
        "gcp": {
          "backend_service": "",
          "certificate_map": "",
          "credentials_path": "",
          "project_id": "",
          "url_map": ""
        },
        "license_key": "",
        "negative_cache_ttl_secs": 10,
        "positive_cache_ttl_secs": 60,
        "resolver_cache_capacity": 50000
      },
      "allOf": [
        {
          "$ref": "#/definitions/CloudConfig"
        }
      ]
    },
    "dev": {
      "default": {
        "conformance_login_html": false,
        "mock_oidc": false,
        "mock_oidc_port": 0,
        "seed_file": ""
      },
      "allOf": [
        {
          "$ref": "#/definitions/DevConfig"
        }
      ]
    },
    "encryption": {
      "default": {
        "active_key_id": "",
        "keys": []
      },
      "allOf": [
        {
          "$ref": "#/definitions/EncryptionConfig"
        }
      ]
    },
    "generators": {
      "default": {},
      "allOf": [
        {
          "$ref": "#/definitions/GeneratorsConfig"
        }
      ]
    },
    "observability": {
      "default": {
        "cache_max": 50000,
        "cache_path": "./data/zitadel-cache.db",
        "gcp_cloud_logging": false,
        "gcp_project_id": "",
        "log_format": "text",
        "log_level": "info",
        "redaction": {
          "ip_mode": "keep",
          "keys": [
            "password",
            "secret",
            "token",
            "client_secret",
            "private_key"
          ],
          "mask": "***REDACTED***"
        },
        "sinks": {
          "analytics": {
            "drain_batch": 500,
            "drain_interval": "5s",
            "enabled": true
          },
          "otel": {
            "auth": "none",
            "endpoint": "",
            "logs_enabled": true,
            "metrics_enabled": true,
            "metrics_endpoint": "",
            "metrics_interval": "60s",
            "protocol": "http",
            "traces_enabled": true,
            "traces_endpoint": ""
          }
        },
        "streams": {
          "event_handler": {
            "mode": "buffered",
            "sample_rate": 0.0,
            "sinks": [
              "stdout",
              "analytics"
            ]
          },
          "event_pusher": {
            "mode": "off",
            "sample_rate": 0.0,
            "sinks": [
              "stdout"
            ]
          },
          "jobs": {
            "mode": "buffered",
            "sample_rate": 0.0,
            "sinks": [
              "stdout",
              "analytics"
            ]
          },
          "queue": null,
          "request": {
            "mode": "sampled",
            "sample_rate": 0.01,
            "sinks": [
              "stdout",
              "otel",
              "analytics"
            ]
          },
          "runtime": {
            "mode": "buffered",
            "sample_rate": 0.0,
            "sinks": [
              "stdout",
              "analytics"
            ]
          }
        }
      },
      "allOf": [
        {
          "$ref": "#/definitions/ObservabilityConfig"
        }
      ]
    },
    "oidc": {
      "default": {
        "access_token_lifetime_secs": 43200,
        "id_token_lifetime_secs": 43200,
        "key_size": 2048,
        "private_key_lifetime_secs": 21600,
        "public_key_lifetime_secs": 108000,
        "refresh_token_idle_secs": 2592000,
        "refresh_token_max_secs": 7776000,
        "signing_algorithm": "RS256"
      },
      "allOf": [
        {
          "$ref": "#/definitions/OidcConfig"
        }
      ]
    },
    "password_hasher": {
      "default": {
        "algorithm": "argon2id",
        "bcrypt_cost": 14,
        "memory_cost_kb": 65536,
        "parallelism": 4,
        "time_cost": 3
      },
      "allOf": [
        {
          "$ref": "#/definitions/PasswordHasherConfig"
        }
      ]
    },
    "rate_limit": {
      "default": {
        "backend": "memory",
        "batch_write": false,
        "gc_interval": 60,
        "redis_url": ""
      },
      "allOf": [
        {
          "$ref": "#/definitions/RateLimitConfig"
        }
      ]
    },
    "secret_hasher": {
      "default": {
        "algorithm": "bcrypt",
        "bcrypt_cost": 4
      },
      "allOf": [
        {
          "$ref": "#/definitions/SecretHasherConfig"
        }
      ]
    },
    "server": {
      "default": {
        "app_access": {
          "admin": {
            "enabled": true,
            "ip_allow": []
          },
          "api": {
            "enabled": true,
            "ip_allow": []
          },
          "console": {
            "enabled": true,
            "ip_allow": []
          },
          "login": {
            "enabled": true,
            "ip_allow": []
          }
        },
        "base_path": "",
        "cookie_secrets": [],
        "external_domain": "localhost",
        "force_insecure_cookies": false,
        "management_secret": "",
        "multi_tenant": false,
        "path_overrides": {
          "api": "",
          "assets": "",
          "console": "",
          "login": "",
          "oidc": "",
          "saml": ""
        },
        "port": 8080,
        "proxy_header_mode": "",
        "public_origin": "",
        "real_ip_header": "",
        "security_headers": {
          "cross_origin_opener": "same-origin",
          "csp_enabled": true,
          "csp_policy": "",
          "csp_report_uri": "",
          "hsts_enabled": true,
          "hsts_max_age": 63072000,
          "hsts_preload": false,
          "hsts_subdomains": true,
          "permissions_policy": "camera=(), microphone=(), geolocation=(), payment=()",
          "referrer_policy": "strict-origin-when-cross-origin",
          "x_content_type_options": true,
          "x_frame_options": "DENY"
        },
        "tls_cert": "",
        "tls_key": "",
        "trusted_proxies": []
      },
      "allOf": [
        {
          "$ref": "#/definitions/ServerConfig"
        }
      ]
    },
    "session": {
      "default": {
        "max_age_secs": 86400
      },
      "allOf": [
        {
          "$ref": "#/definitions/SessionConfig"
        }
      ]
    },
    "storage": {
      "default": {
        "analytics": {
          "backend": "inherit",
          "credentials_file": "",
          "credentials_json": "",
          "database": "",
          "emulator_host": "",
          "url": ""
        },
        "primary": {
          "backend": "",
          "bootstrap": "",
          "conn_max_lifetime": "1h",
          "credentials_file": "",
          "credentials_json": "",
          "database": "",
          "emulator_host": "",
          "max_idle_conns": 5,
          "max_open_conns": 25,
          "migrate": "",
          "replica": {
            "enabled": false,
            "mode": "explicit",
            "url": ""
          },
          "url": "sqlite://./data/zitadel.db"
        },
        "retention": {
          "events": {
            "keep_for": "14d"
          },
          "sessions": {
            "retain_terminal_for": "7d"
          },
          "tokens": {
            "retain_terminal_for": "7d"
          },
          "transient_auth_state": {
            "retain_after_expiry": "1h"
          }
        },
        "transient": {
          "backend": "inherit",
          "credentials_file": "",
          "credentials_json": "",
          "database": "",
          "emulator_host": "",
          "url": ""
        }
      },
      "allOf": [
        {
          "$ref": "#/definitions/StorageConfig"
        }
      ]
    },
    "tls": {
      "default": {
        "ca_dir": "",
        "email": "",
        "http_port": 80,
        "https_port": 443,
        "mode": ""
      },
      "allOf": [
        {
          "$ref": "#/definitions/TlsConfig"
        }
      ]
    },
    "workers": {
      "default": {
        "cleanup_batch_size": 500,
        "cleanup_max_rows_per_run": 2000,
        "cleanup_max_run_duration": "2s",
        "event_consumer_poll_interval": "5s",
        "event_partition_premake_days": 3,
        "event_workers": 1,
        "lake_batch_size": 1000,
        "lake_batch_window_secs": 5,
        "notification_workers": 1,
        "scheduler_enabled": true,
        "scheduler_lease_ttl": "90s",
        "scheduler_poll_interval": "30s"
      },
      "allOf": [
        {
          "$ref": "#/definitions/WorkersConfig"
        }
      ]
    }
  },
  "definitions": {
    "AnalyticsSinkConfig": {
      "type": "object",
      "properties": {
        "drain_batch": {
          "default": 500,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "drain_interval": {
          "default": "5s",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        }
      }
    },
    "AnalyticsStorageConfig": {
      "type": "object",
      "properties": {
        "backend": {
          "default": "inherit",
          "type": "string"
        },
        "credentials_file": {
          "default": "",
          "type": "string"
        },
        "credentials_json": {
          "default": "",
          "type": "string"
        },
        "database": {
          "default": "",
          "type": "string"
        },
        "emulator_host": {
          "default": "",
          "type": "string"
        },
        "url": {
          "default": "",
          "type": "string"
        }
      }
    },
    "AppAccessConfig": {
      "type": "object",
      "properties": {
        "admin": {
          "default": {
            "enabled": true,
            "ip_allow": []
          },
          "allOf": [
            {
              "$ref": "#/definitions/AppAccessEntry"
            }
          ]
        },
        "api": {
          "default": {
            "enabled": true,
            "ip_allow": []
          },
          "allOf": [
            {
              "$ref": "#/definitions/AppAccessEntry"
            }
          ]
        },
        "console": {
          "default": {
            "enabled": true,
            "ip_allow": []
          },
          "allOf": [
            {
              "$ref": "#/definitions/AppAccessEntry"
            }
          ]
        },
        "login": {
          "default": {
            "enabled": true,
            "ip_allow": []
          },
          "allOf": [
            {
              "$ref": "#/definitions/AppAccessEntry"
            }
          ]
        }
      }
    },
    "AppAccessEntry": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "ip_allow": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "CacheConfig": {
      "type": "object",
      "properties": {
        "shared": {
          "default": {
            "backend": "disabled",
            "url": ""
          },
          "allOf": [
            {
              "$ref": "#/definitions/SharedCacheConfig"
            }
          ]
        }
      }
    },
    "CatalogConfig": {
      "type": "object",
      "properties": {
        "local_path": {
          "default": "",
          "type": "string"
        },
        "refresh_interval": {
          "default": "",
          "type": "string"
        },
        "url": {
          "default": "",
          "type": "string"
        }
      }
    },
    "CloudConfig": {
      "type": "object",
      "properties": {
        "control_plane": {
          "default": {
            "secret_ref": "",
            "url": ""
          },
          "allOf": [
            {
              "$ref": "#/definitions/CloudControlPlaneConfig"
            }
          ]
        },
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "gcp": {
          "default": {
            "backend_service": "",
            "certificate_map": "",
            "credentials_path": "",
            "project_id": "",
            "url_map": ""
          },
          "allOf": [
            {
              "$ref": "#/definitions/GcpInfraConfig"
            }
          ]
        },
        "license_key": {
          "description": "License key for cloud features. Required when `enabled = true`. Cloud functionality will not activate without a valid key.",
          "default": "",
          "type": "string"
        },
        "negative_cache_ttl_secs": {
          "default": 10,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "positive_cache_ttl_secs": {
          "default": 60,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "resolver_cache_capacity": {
          "default": 50000,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "CloudControlPlaneConfig": {
      "type": "object",
      "properties": {
        "secret_ref": {
          "default": "",
          "type": "string"
        },
        "url": {
          "default": "",
          "type": "string"
        }
      }
    },
    "DevConfig": {
      "type": "object",
      "properties": {
        "conformance_login_html": {
          "default": false,
          "type": "boolean"
        },
        "mock_oidc": {
          "default": false,
          "type": "boolean"
        },
        "mock_oidc_port": {
          "default": 0,
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "seed_file": {
          "default": "",
          "type": "string"
        }
      }
    },
    "EncryptionConfig": {
      "type": "object",
      "properties": {
        "active_key_id": {
          "default": "",
          "type": "string"
        },
        "keys": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/EncryptionKey"
          }
        }
      }
    },
    "EncryptionKey": {
      "type": "object",
      "required": [
        "id",
        "secret"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "secret": {
          "type": "string"
        }
      }
    },
    "EventRetentionConfig": {
      "type": "object",
      "properties": {
        "keep_for": {
          "default": "14d",
          "type": "string"
        }
      }
    },
    "ExpiredDataRetentionConfig": {
      "type": "object",
      "properties": {
        "retain_after_expiry": {
          "default": "1h",
          "type": "string"
        }
      }
    },
    "GcpInfraConfig": {
      "description": "GCP infrastructure configuration for domain provisioning.",
      "type": "object",
      "properties": {
        "backend_service": {
          "description": "Backend service name (e.g. \"zitadel-backend\").",
          "default": "",
          "type": "string"
        },
        "certificate_map": {
          "description": "Certificate map name (e.g. \"zitadel-cert-map\").",
          "default": "",
          "type": "string"
        },
        "credentials_path": {
          "description": "Path to service account JSON. Empty = use workload identity.",
          "default": "",
          "type": "string"
        },
        "project_id": {
          "description": "GCP project ID.",
          "default": "",
          "type": "string"
        },
        "url_map": {
          "description": "URL map name for the GLB (e.g. \"zitadel-lb\").",
          "default": "",
          "type": "string"
        }
      }
    },
    "GeneratorProfileOverride": {
      "description": "Per-purpose secret generator profile override in TOML.\n\nOnly fields explicitly set override the compiled-in defaults. This mirrors the profile shape from `zitadel-crypto::generator::GeneratorProfile` but lives in the config crate to avoid a circular dependency.",
      "type": "object",
      "properties": {
        "charset": {
          "type": [
            "string",
            "null"
          ]
        },
        "custom_chars": {
          "type": [
            "string",
            "null"
          ]
        },
        "dash_interval": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0.0
        },
        "expiry_secs": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "length": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0.0
        }
      }
    },
    "GeneratorsConfig": {
      "description": "Generator configuration section in TOML.\n\nKeys are purpose names (e.g., `client_secret`, `otp_sms`). Values are partial overrides of the compiled-in defaults.",
      "type": "object"
    },
    "HashAlgorithm": {
      "description": "Password hashing algorithm selection.",
      "type": "string",
      "enum": [
        "argon2id",
        "bcrypt"
      ]
    },
    "ObservabilityConfig": {
      "type": "object",
      "properties": {
        "cache_max": {
          "default": 50000,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "cache_path": {
          "default": "./data/zitadel-cache.db",
          "type": "string"
        },
        "gcp_cloud_logging": {
          "default": false,
          "type": "boolean"
        },
        "gcp_project_id": {
          "default": "",
          "type": "string"
        },
        "log_format": {
          "default": "text",
          "type": "string"
        },
        "log_level": {
          "default": "info",
          "type": "string"
        },
        "redaction": {
          "default": {
            "ip_mode": "keep",
            "keys": [
              "password",
              "secret",
              "token",
              "client_secret",
              "private_key"
            ],
            "mask": "***REDACTED***"
          },
          "allOf": [
            {
              "$ref": "#/definitions/RedactionConfig"
            }
          ]
        },
        "sinks": {
          "default": {
            "analytics": {
              "drain_batch": 500,
              "drain_interval": "5s",
              "enabled": true
            },
            "otel": {
              "auth": "none",
              "endpoint": "",
              "logs_enabled": true,
              "metrics_enabled": true,
              "metrics_endpoint": "",
              "metrics_interval": "60s",
              "protocol": "http",
              "traces_enabled": true,
              "traces_endpoint": ""
            }
          },
          "allOf": [
            {
              "$ref": "#/definitions/SinksConfig"
            }
          ]
        },
        "streams": {
          "default": {
            "event_handler": {
              "mode": "buffered",
              "sample_rate": 0.0,
              "sinks": [
                "stdout",
                "analytics"
              ]
            },
            "event_pusher": {
              "mode": "off",
              "sample_rate": 0.0,
              "sinks": [
                "stdout"
              ]
            },
            "jobs": {
              "mode": "buffered",
              "sample_rate": 0.0,
              "sinks": [
                "stdout",
                "analytics"
              ]
            },
            "queue": null,
            "request": {
              "mode": "sampled",
              "sample_rate": 0.01,
              "sinks": [
                "stdout",
                "otel",
                "analytics"
              ]
            },
            "runtime": {
              "mode": "buffered",
              "sample_rate": 0.0,
              "sinks": [
                "stdout",
                "analytics"
              ]
            }
          },
          "allOf": [
            {
              "$ref": "#/definitions/StreamRoutingConfig"
            }
          ]
        }
      }
    },
    "OidcConfig": {
      "description": "OIDC provider configuration: signing keys, key lifecycle, and token lifetimes.",
      "type": "object",
      "properties": {
        "access_token_lifetime_secs": {
          "description": "Access token lifetime (seconds). Default: 43200 (12h).",
          "default": 43200,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "id_token_lifetime_secs": {
          "description": "ID token lifetime (seconds). Default: 43200 (12h).",
          "default": 43200,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "key_size": {
          "description": "RSA key size in bits (ignored for EC). Default: 2048.",
          "default": 2048,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "private_key_lifetime_secs": {
          "description": "How long a private signing key is used before rotation (seconds). Default: 6h.",
          "default": 21600,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "public_key_lifetime_secs": {
          "description": "How long a public key remains available for verification after rotation (seconds). Default: 30h.",
          "default": 108000,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "refresh_token_idle_secs": {
          "description": "Refresh token idle expiration (seconds). Default: 2592000 (720h).",
          "default": 2592000,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "refresh_token_max_secs": {
          "description": "Refresh token absolute max lifetime (seconds). Default: 7776000 (2160h).",
          "default": 7776000,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "signing_algorithm": {
          "description": "JWT signing algorithm (default: RS256).",
          "default": "RS256",
          "allOf": [
            {
              "$ref": "#/definitions/SigningAlgorithm"
            }
          ]
        }
      }
    },
    "OtelSinkConfig": {
      "type": "object",
      "properties": {
        "auth": {
          "default": "none",
          "type": "string"
        },
        "endpoint": {
          "default": "",
          "type": "string"
        },
        "logs_enabled": {
          "default": true,
          "type": "boolean"
        },
        "metrics_enabled": {
          "default": true,
          "type": "boolean"
        },
        "metrics_endpoint": {
          "default": "",
          "type": "string"
        },
        "metrics_interval": {
          "default": "60s",
          "type": "string"
        },
        "protocol": {
          "default": "http",
          "type": "string"
        },
        "traces_enabled": {
          "default": true,
          "type": "boolean"
        },
        "traces_endpoint": {
          "default": "",
          "type": "string"
        }
      }
    },
    "PasswordHasherConfig": {
      "description": "Configuration for the primary password hasher.\n\nThese are system-level (TOML) settings, not per-org policy. Password *policy* (min length, complexity) lives in the settings table.",
