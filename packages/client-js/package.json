{
  "name": "@zitadel/client-js",
  "version": "0.1.0",
  "type": "module",
  "description": "Auto-generated TypeScript client for the Zitadel API",
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "publishConfig": {
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "generate": "openapi-ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run generate && npm run build",
    "clean": "rm -rf dist src/generated"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.8.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.64.0",
    "typescript": "^5.6.0"
  }
}
