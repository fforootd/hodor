{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zitadel",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-27",
  "build": {
    "command": "npm --prefix ../.. run build"
  },

  // ── Observability ────────────────────────────────────────────────────────
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },

  // ── Placement ─────────────────────────────────────────────────────────────
  //
  // Pin the Worker near the Turso database region (aws-us-west-2) so the
  // container is co-located with the database and avoids cross-continent RTT.
  "placement": {
    "region": "aws:us-west-2"
  },

  // ── Static Assets ────────────────────────────────────────────────────────
  //
  // Serve the built frontend bundles from Workers Assets so the container
  // only handles HTML shells, API traffic, OIDC, and dynamic login assets.
  "assets": {
    "binding": "ASSETS",
    "directory": "../../web/dist",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": [
      "/",
      "/src/*",
      "/assets/login/*",
      "/healthz",
      "/readyz",
      "/openapi.json",
      "/.well-known/*",
      "/authorize",
      "/authorize/*",
      "/oauth/*",
      "/userinfo",
      "/end_session",
      "/keys",
      "/revoke",
      "/devicecode",
      "/v1/*",
      "/login",
      "/login/*",
      "/account",
      "/account/*",
      "/console",
      "/console/*"
    ]
  },

  // ── Container Definition ─────────────────────────────────────────────────
  //
  // Image options:
  //   "./Dockerfile"  — build locally (requires Docker)
  //   "ghcr.io/zitadel/zitadel:<TAG>" — use goreleaser GHCR image
  //
  // Instance types:
  //   lite       → 1/16 vCPU,  256 MiB RAM,  2 GB disk
  //   basic      → 1/4  vCPU,  1   GiB RAM,  4 GB disk
  //   standard-1 → 1/2  vCPU,  4   GiB RAM,  8 GB disk
  //
  "containers": [
    {
      "class_name": "ZitadelContainer",
      "image": "../../Dockerfile.cloudflare",
      // For production deploys where image provenance matters, use:
      //   npm run deploy:immutable
      // That flow uses Wrangler's explicit build/push path, then deploys
      // against the exact registry image reference it just produced.
      // Keep this single-instance for now because Zitadel starts schedulers
      // and other background work inside the Go process.
      "max_instances": 1,
      "instance_type": "standard-1"
    }
  ],
  // ── Database Wiring ──────────────────────────────────────────────────────
  //
  // This example expects an external database URL via Worker secrets:
  //   ZITADEL_DATABASE_URL=libsql://<db>.turso.io
  //   ZITADEL_DATABASE_AUTH_TOKEN=<token>

  // ── Durable Object Binding ───────────────────────────────────────────────
  "durable_objects": {
    "bindings": [
      {
        "name": "ZITADEL",
        "class_name": "ZitadelContainer"
      }
    ]
  },
  // ── Migrations ───────────────────────────────────────────────────────────
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ZitadelContainer"
      ]
    }
  ]
}
