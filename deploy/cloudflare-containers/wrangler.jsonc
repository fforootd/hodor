{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zitadel",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-27",
  "build": {
    "command": "npm --prefix ../.. run build"
  },

  // ── Observability ────────────────────────────────────────────────────────
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },

  // ── Placement ─────────────────────────────────────────────────────────────
  //
  // Pin the Worker near the D1/Turso region so the container is co-located
  // with the database and avoids cross-continent RTT.
  "placement": {
    "region": "aws:us-west-2"
  },

  // ── Static Assets ────────────────────────────────────────────────────────
  //
  // Serve the built frontend bundles from Workers Assets so the container
  // only handles HTML shells, API traffic, OIDC, and dynamic login assets.
  "assets": {
    "binding": "ASSETS",
    "directory": "../../web/dist",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": [
      "/",
      "/src/*",
      "/assets/login/*",
      "/healthz",
      "/readyz",
      "/openapi.json",
      "/.well-known/*",
      "/authorize",
      "/authorize/*",
      "/oauth/*",
      "/userinfo",
      "/end_session",
      "/keys",
      "/revoke",
      "/devicecode",
      "/v1/*",
      "/login",
      "/login/*",
      "/account",
      "/account/*",
      "/console",
      "/console/*",
      "/_admin/*",
      "/_health"
    ]
  },

  // ── Container Definition ─────────────────────────────────────────────────
  //
  // Image options:
  //   "./Dockerfile"  — build locally (requires Docker)
  //   "ghcr.io/zitadel/zitadel:<TAG>" — use goreleaser GHCR image
  //
  // Instance types:
  //   lite       → 1/16 vCPU,  256 MiB RAM,  2 GB disk
  //   basic      → 1/4  vCPU,  1   GiB RAM,  4 GB disk
  //   standard-1 → 1/2  vCPU,  4   GiB RAM,  8 GB disk
  //
  "containers": [
    {
      "class_name": "ZitadelContainer",
      "image": "../../Dockerfile.cloudflare",
      // For production deploys where image provenance matters, use:
      //   npm run deploy:immutable
      // Allow multiple container instances for multi-tenant. Each tenant
      // gets its own container via a unique Durable Object ID.
      "max_instances": 10,
      "instance_type": "standard-1"
    }
  ],

  // ── Database Wiring ──────────────────────────────────────────────────────
  //
  // Default: D1 via outboundByHost bridge (database ID from DO config).
  // BYODB: Turso/Postgres URL passed as ZITADEL_DATABASE_URL env var.
  //
  // Required Worker secrets for D1 bridge:
  //   CLOUDFLARE_ACCOUNT_ID — Cloudflare account ID
  //   CLOUDFLARE_API_TOKEN  — API token with D1 read/write permissions

  // ── Durable Object Bindings ──────────────────────────────────────────────
  "durable_objects": {
    "bindings": [
      {
        "name": "ZITADEL",
        "class_name": "ZitadelContainer"
      },
      {
        "name": "ROUTER",
        "class_name": "ZitadelRouter"
      }
    ]
  },

  // ── Migrations ───────────────────────────────────────────────────────────
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ZitadelContainer"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "ZitadelRouter"
      ]
    }
  ]
}
